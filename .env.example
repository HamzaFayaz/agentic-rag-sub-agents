# Copy to backend/.env and frontend/.env (do not commit real values)

# --- Backend ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag-module-1
LANGSMITH_TRACING=false
CORS_ORIGINS=http://localhost:5173

# Module 2: embeddings + RAG
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
RAG_MATCH_THRESHOLD=0.7
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Frontend (prefix with VITE_) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=

# Leave empty to use Vite proxy (/api -> localhost:8000).
# If streaming appears all-at-once, set: VITE_API_URL=http://localhost:8000
