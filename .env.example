# Copy to backend/.env and frontend/.env (do not commit real values)

# --- Backend ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
# LangSmith: set API key AND LANGSMITH_TRACING=true for full RAG traces
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag-module-1
LANGSMITH_TRACING=false
# When false (default), traces log 200-char snippets only — not full chunk bodies
LANGSMITH_LOG_CHUNK_TEXT=false
CORS_ORIGINS=http://localhost:5173

# Module 2: embeddings + RAG
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
RAG_MATCH_THRESHOLD=0.5
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE=600
CHUNK_OVERLAP=120
MAX_CHUNK_TOKENS=800
MIN_HEADINGS_FOR_SECTION=2

# Module 4: LLM metadata extraction
METADATA_EXTRACTION_ENABLED=true
METADATA_MODEL=gpt-4o-mini

# Module 6: hybrid search + Cohere rerank
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5
RERANK_ENABLED=true
RERANK_TOP_N=8
HYBRID_CANDIDATE_K=40

# --- Frontend (prefix with VITE_) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=

# Leave empty to use Vite proxy (/api -> localhost:8000).
# If streaming appears all-at-once, set: VITE_API_URL=http://localhost:8000
