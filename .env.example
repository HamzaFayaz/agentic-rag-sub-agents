# Copy to backend/.env and frontend/.env (do not commit real values)

# --- Backend ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Dev inspect script (Scripts/inspect_m7_data.py) — pick one auth method:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_DEV_EMAIL=your-login@email.com
# SUPABASE_DEV_PASSWORD=your-password
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
# LangSmith: set API key AND LANGSMITH_TRACING=true for full RAG traces
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag-module-1
LANGSMITH_TRACING=false
# When false (default), traces log 200-char snippets only — not full chunk bodies
LANGSMITH_LOG_CHUNK_TEXT=false
CORS_ORIGINS=http://localhost:5173

# Module 2: embeddings + RAG
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
RAG_MATCH_THRESHOLD=0.5
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE=600
CHUNK_OVERLAP=120
MAX_CHUNK_TOKENS=800
MIN_HEADINGS_FOR_SECTION=2

# Module 4: LLM metadata extraction
METADATA_EXTRACTION_ENABLED=true
METADATA_MODEL=gpt-4o-mini

# Module 6: hybrid search + Cohere rerank
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5
RERANK_ENABLED=true
RERANK_TOP_N=8
HYBRID_CANDIDATE_K=40

# Module 7: multi-tool agent (Text-to-SQL, web search, tool-calling loop)
TEXT_TO_SQL_ENABLED=true
WEB_SEARCH_ENABLED=true
# Tavily web search — omit key to disable web_search tool (RAG + SQL still work)
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
# Postgres pooler URL for read-only SQL execution with RLS (Supabase → Settings → Database)
DATABASE_URL=
SQL_ROW_LIMIT=100
SQL_QUERY_TIMEOUT_SEC=5
AGENT_MAX_TOOL_ITERATIONS=3

# --- Frontend (prefix with VITE_) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_URL=

# Leave empty to use Vite proxy (/api -> localhost:8000).
# If streaming appears all-at-once, set: VITE_API_URL=http://localhost:8000
